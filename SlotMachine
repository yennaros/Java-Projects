
import java.util.Random;
import java.util.Scanner;

public class Main {
    static Scanner scanner = new Scanner(System.in);
    static Random random = new Random();


    public static void main(String[] args) {

        System.out.println("***********************");
        System.out.println(" Welcome to Java Slots ");
        System.out.println("Symbols: 🍒🍉🍋🔔⭐🎰");
        System.out.println("***********************");

        int playerBalance = 100;
        int bet = 0;
        char keepPlaying = 'Y';
        String[] symbols = {"🍒","🍉","🍋","🔔","⭐","🎰"};
        String[] slotMachine = new String[3];

        do{
            System.out.println("Your balance: $" + playerBalance);
            System.out.print("Place your bet: ");
            bet = scanner.nextInt();
            if(bet > playerBalance){
                System.out.println("Bet higher than your balance, try again.\n");
                continue;
            }

            System.out.println("\nSpining...");
            System.out.println("*************");

            for(int i = 0; i < 3; i++){
                slotMachine[i] = symbols[random.nextInt(6)];
            }
            System.out.println(slotMachine[0] + " | " + slotMachine[1] + " | " +
                    slotMachine[2]);
            System.out.println("*************");

            if (slotMachine[0].equals(slotMachine[1]) &&
                    slotMachine[0].equals(slotMachine[2])){
                bet *= 10;
                System.out.println("You won $" + bet);
                playerBalance += bet;

            } else if (slotMachine[0].equals(slotMachine[1]) || slotMachine[0].equals(slotMachine[2])
                    || slotMachine[1].equals(slotMachine[2])) {
                bet *= 5;
                System.out.println("You won $" + bet);
                playerBalance += bet;

            }else {
                playerBalance -= bet;
                System.out.println("You lost");

            }
            System.out.println("Current balance: $"+ playerBalance);
            if (playerBalance == 0){
                System.out.println("No more resources, you can't kepp " +
                        "playing.");
                break;
            }

            System.out.print("Do you want to keep playing (Y/N): ");
            keepPlaying = scanner.next().charAt(0);




        }while(keepPlaying == 'Y');
        System.out.println("Thanks for playing!");


        scanner.close();
    }

}
